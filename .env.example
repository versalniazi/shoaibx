# ---------------------------------------------------------------------------
# SHOAIBX LIMITED website — environment variables
# Copy to `.env.local` for local development. In production, set these in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# NEVER commit real secrets. Variables starting with NEXT_PUBLIC_ are visible in the browser.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# The final public URL, without a trailing slash. Used for canonical URLs,
# the sitemap, robots.txt, Open Graph tags and structured data. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.uk

# Set to "true" on staging/preview deployments to block search engine indexing.
NEXT_PUBLIC_NOINDEX=false

# --- Contact form email delivery (configure ONE option) -----------------------
# Where enquiries are delivered. Defaults to shoibxlimited@gmail.com if unset.
CONTACT_TO_EMAIL=shoibxlimited@gmail.com
# The "From" address. With Resend this must be on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="SHOAIBX Website <website@your-domain.co.uk>"

# Option A (recommended): Resend — https://resend.com (free tier available)
RESEND_API_KEY=

# Option B: any SMTP server (e.g. Google Workspace, Microsoft 365, Zoho, Brevo, Mailgun).
# For a Gmail account use smtp.gmail.com, port 465, and a Google "App password"
# (requires 2-Step Verification) — never your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Optional extra spam protection: Cloudflare Turnstile -------------------
# https://dash.cloudflare.com → Turnstile. Leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics & marketing (only loaded AFTER the visitor gives consent) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID — numbers only
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Search Console --------------------------------------------------
# The content value of the HTML-tag verification method (just the token).
GOOGLE_SITE_VERIFICATION=

# --- Social profiles (optional; shown in the footer and structured data) ----
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
